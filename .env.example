# Necessário somente para execução real; nunca use prefixo NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=
# ID do catálogo do AI Gateway: provedor/modelo. Sem modelo padrão implícito.
JARVIS_MODEL=
# Identidade administrativa provisionada no servidor.
JARVIS_ADMIN_ID=
# Token aleatório com pelo menos 32 caracteres; não reutilize senha pessoal.
JARVIS_ADMIN_TOKEN=
# O agente usa o modo real; MockModel existe somente nos testes.
# Nenhuma inferência é executada ao compilar. Veja docs/AI_GATEWAY_SETUP.md.
# AI_GATEWAY_BASE_URL não é utilizado: endpoint padrão do provider oficial.
